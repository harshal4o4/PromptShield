# PromptShield Environment Configuration Example
# Copy to .env for local development

# Backend Settings
PROMPTSHIELD_HOST=127.0.0.1
PROMPTSHIELD_PORT=8000
PROMPTSHIELD_DB_PATH=promptshield.db
PROMPTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROMPTSHIELD_LOG_LEVEL=INFO
PROMPTSHIELD_MAX_TEXT_LENGTH=10000

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000
