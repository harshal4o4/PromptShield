PROMPTSHIELD_HOST=127.0.0.1
PROMPTSHIELD_PORT=8000
PROMPTSHIELD_DB_PATH=promptshield.db
PROMPTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROMPTSHIELD_LOG_LEVEL=INFO
PROMPTSHIELD_MAX_TEXT_LENGTH=100000

# Optional Groq API credentials for Meta Llama Prompt Guard 2 & Protected Model
# PROMPTSHIELD_GROQ_API_KEY=gsk_your_groq_api_key_here
PROMPTSHIELD_GROQ_PROMPT_GUARD_MODEL=llama-guard-3-8b
PROMPTSHIELD_GROQ_AI_MODEL=llama-3.3-70b-versatile
PROMPTSHIELD_CLASSIFIER_PROVIDER=auto
PROMPTSHIELD_CLASSIFIER_FAILURE_POLICY=fallback_heuristics
PROMPTSHIELD_CLASSIFIER_TIMEOUT_SECONDS=3.0

# File Inspection limits
PROMPTSHIELD_MAX_FILE_SIZE_MB=5

# Protected Canary Tokens
PROMPTSHIELD_CANARY_SECRETS=PS_DEMO_SECRET_7F3A,PS_CANARY_ROOT_9921,PS_ENTERPRISE_KEY_X882

# Admin Authorization Key for Policy Updates
PROMPTSHIELD_ADMIN_API_KEY=promptshield-secops-admin-key
